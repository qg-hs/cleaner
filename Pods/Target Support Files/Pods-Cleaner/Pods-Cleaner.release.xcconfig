CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EMBEDDED_CONTENT_CONTAINS_SWIFT = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CleanerBigOldFile" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerDuplicateFile" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileManager" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileMove" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerLoginItemManager" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerPhotoClean" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerPrivacyClean" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerSpaceAnalyse" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerStat" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerUninstaller" "${PODS_CONFIGURATION_BUILD_DIR}/FMDB" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/QMAppLoginItemManage" "${PODS_CONFIGURATION_BUILD_DIR}/QMCoreFunction" "${PODS_CONFIGURATION_BUILD_DIR}/QMUICommon" "${PODS_CONFIGURATION_BUILD_DIR}/YMTreeMap"
GCC_C_LANGUAGE_STANDARD = gnu89
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CleanerBigOldFile/CleanerBigOldFile.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerDuplicateFile/CleanerDuplicateFile.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileManager/CleanerFileManager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileMove/CleanerFileMove.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerLoginItemManager/CleanerLoginItemManager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerPhotoClean/CleanerPhotoClean.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerPrivacyClean/CleanerPrivacyClean.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerSpaceAnalyse/CleanerSpaceAnalyse.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerStat/CleanerStat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CleanerUninstaller/CleanerUninstaller.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FMDB/FMDB.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QMAppLoginItemManage/QMAppLoginItemManage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QMCoreFunction/QMCoreFunction.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QMUICommon/QMUICommon.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YMTreeMap/YMTreeMap.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/../Frameworks' '@loader_path/Frameworks' "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}"
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"pcap" -l"sqlite3" -framework "AppKit" -framework "CleanerBigOldFile" -framework "CleanerDuplicateFile" -framework "CleanerFileManager" -framework "CleanerFileMove" -framework "CleanerLoginItemManager" -framework "CleanerPhotoClean" -framework "CleanerPrivacyClean" -framework "CleanerSpaceAnalyse" -framework "CleanerStat" -framework "CleanerUninstaller" -framework "Cocoa" -framework "CoreServices" -framework "DiskArbitration" -framework "FMDB" -framework "Foundation" -framework "IOKit" -framework "Masonry" -framework "QMAppLoginItemManage" -framework "QMCoreFunction" -framework "QMUICommon" -framework "Security" -framework "SystemConfiguration" -framework "YMTreeMap"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerBigOldFile" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerDuplicateFile" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileManager" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerFileMove" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerLoginItemManager" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerPhotoClean" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerPrivacyClean" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerSpaceAnalyse" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerStat" "-F${PODS_CONFIGURATION_BUILD_DIR}/CleanerUninstaller" "-F${PODS_CONFIGURATION_BUILD_DIR}/FMDB" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/QMAppLoginItemManage" "-F${PODS_CONFIGURATION_BUILD_DIR}/QMCoreFunction" "-F${PODS_CONFIGURATION_BUILD_DIR}/QMUICommon" "-F${PODS_CONFIGURATION_BUILD_DIR}/YMTreeMap"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
